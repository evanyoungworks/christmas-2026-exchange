rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One wishlist per participant. Only these ids exist.
    match /wishlists/{pid} {
      allow read: if pid in ['michelle-young', 'doug-young', 'eric-young', 'beth-young', 'evan-young', 'anna-toner'];
      allow create, update: if pid in ['michelle-young', 'doug-young', 'eric-young', 'beth-young', 'evan-young', 'anna-toner']
        && request.resource.data.keys().hasOnly(['name', 'items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;
      allow delete: if false;
    }
    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
